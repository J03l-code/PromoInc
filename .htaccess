# PromoInc — Configuración de Servidor Definitiva
# Forzar el uso de archivos estáticos y PHP, ignorando Node/Next

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # 301 Canonical Redirect: Forzar / en lugar de index.php o home.html para evitar contenido duplicado en Google
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(index\.php|home\.html)\ HTTP/ [NC]
    RewriteRule ^(index\.php|home\.html)$ / [R=301,L]

    # Redirigir sitemap.xml a sitemap.php de forma transparente
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Redirigir peticiones de .html a .php de forma transparente para mantener compatibilidad
    RewriteRule ^producto\.html$ producto.php [L,QSA]
    RewriteRule ^catalogo\.html$ catalogo.php [L,QSA]

    # Friendly URLs para Productos: /producto/12-taza-neon-personalizada -> producto.php?id=12
    RewriteRule ^producto/([0-9]+)-?([^/]*)$ producto.php?id=$1 [L,QSA]

    # Friendly URLs para Categorías: /catalogo/categoria/4-oficina -> catalogo.php?category=$1
    RewriteRule ^catalogo/categoria/([0-9]+)-?([^/]*)$ catalogo.php?category=$1 [L,QSA]

    # Si la petición es para una carpeta o archivo que existe, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Evitar que Next.js o rutas fantasmas tomen el control
    # Si no es un archivo real, redirigir al index.php directamente para evitar redirecciones cliente intermedias
    RewriteRule ^ index.php [L]
</IfModule>

# Habilitar compresión Gzip/Deflate para acelerar la transferencia de archivos
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml font/ttf font/otf
</IfModule>

# Habilitar caché de navegador para archivos estáticos (1 año para imágenes, 1 mes para CSS/JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Forzar limpieza de caché en archivos HTML/PHP para ver cambios de código inmediatos
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # Cabeceras de Seguridad
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# Bloquear acceso web a archivos de configuración, entorno, bases de datos y scripts sensibles
<FilesMatch "(^\.env|\.sql$|\.log$|\.ini$|\.sh$|\.py$|composer\.(json|lock)|package(-lock)?\.json)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear scripts de mantenimiento y diagnóstico en producción
<FilesMatch "^(check|debug_session|db_init|db_full_init|db_upgrade.*)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

